# Trading Bot Configuration
# Copy this to .env and fill in your values

# Binance API Credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Trading Configuration
TRADING_PAIR=USDCUSDT
GRID_SIZE=0.0001
GRID_LEVELS=20  # 10 buy + 10 sell orders
TOTAL_INVESTMENT=100

# Risk Management
MAX_POSITION_SIZE=0.7  # Never risk more than 70% of capital
MAX_ORDERS_PER_SIDE=5  # Limit concurrent orders per side
STOP_PRICE_DEVIATION=0.002  # Stop if price moves more than 0.2%

# Bot Configuration
CHECK_INTERVAL=30  # Seconds between checks
DRY_RUN=true  # Set to false for real trading
LOG_LEVEL=INFO
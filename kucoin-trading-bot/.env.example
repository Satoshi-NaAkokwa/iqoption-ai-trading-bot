# KuCoin Trading Bot Configuration

# API Credentials (will be loaded from environment or .env file)
KUCOIN_API_KEY=your_api_key_here
KUCOIN_API_SECRET=your_api_secret_here
KUCOIN_API_PASSPHRASE=your_passphrase_here

# Environment
NODE_ENV=production
LOG_LEVEL=info

# Trading Configuration
MAX_POSITION_SIZE=1000  # Max USDT per position
RISK_PER_TRADE=0.02     # 2% risk per trade
MAX_DAILY_LOSS=500      # Stop trading after $500 daily loss
LEVERAGE=1              # Default leverage

# LLM Configuration
LLM_ENDPOINT=http://localhost:11434/api/generate
LLM_MODEL=llama2
LLM_TIMEOUT=30000

# Trading Pairs
TRADING_PAIRS=BTC-USDT,ETH-USDT,SOL-USDT
PREFERRED_PAIRS=BTC-USDT,ETH-USDT

# Strategy Settings
STRATEGY=hybrid
MIN_CONFIDENCE=0.7
TAKE_PROFIT_PERCENT=2.0
STOP_LOSS_PERCENT=1.0

# Monitoring
CHECK_INTERVAL=60000    # Check every 60 seconds
HEARTBEAT_INTERVAL=300000  # Heartbeat every 5 minutes

# Notifications
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
NOTIFY_ON_TRADE=true
NOTIFY_ON_ERROR=true
NOTIFY_DAILY_SUMMARY=true
# Solana Configuration (REQUIRED)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WALLET_PRIVATE_KEY=your_base58_private_key_here

# Optional: Custom RPC for better rate limits
# SOLANA_RPC_URL=https://rpc.helius.io/?api-key=your_helius_key

# Discord Bot Configuration (Optional - for Community Agent)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Twitter API Configuration (Optional - for Community Agent)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Telegram Bot Configuration (Optional - for Community Agent)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Content Generation API (Optional - for Content Agent)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Market Data APIs (Optional - for Analytics Agent)
COINMARKETCAP_API_KEY=your_coinmarketcap_key_here
COINGECKO_API_KEY=your_coingecko_key_here

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Webhook URLs (Optional - for notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email Configuration (Optional - for reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Security
JWT_SECRET=your_random_jwt_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Feature Flags
ENABLE_AUTO_PUBLISH=false
ENABLE_AUTO_TRADING=false
ENABLE_DISCORD_MODERATION=true

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
NODE_ENV=development
PORT=3000
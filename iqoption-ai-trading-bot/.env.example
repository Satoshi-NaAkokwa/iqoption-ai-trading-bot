# IQ Option Credentials
IQOPTION_EMAIL=your_email@example.com
IQOPTION_PASSWORD=your_password
IQOPTION_DEMO_MODE=true
IQOPTION_PRACTICE_MODE=true

# LLM API Configuration (OpenAI)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# Trading Parameters
DEFAULT_TRADE_AMOUNT=1.0
MAX_CONCURRENT_TRADES=3
DAILY_LOSS_LIMIT=10.0
MAX_RISK_PER_TRADE=0.02
RISK_REWARD_RATIO=2.0

# Risk Management
MAX_DAILY_TRADES=20
MAX_LOSS_PER_DAY=5.0
MAX_DRAWDOWN=0.10